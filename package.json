{
  "name": "uncle-chess",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn typecheck && vite build",
    "preview": "vite preview",
    "deploy": "yarn build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-types": "wrangler types"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chess.js": "^1.4.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "packageManager": "yarn@4.18.1",
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "workerd": {
      "built": true
    }
  }
}
